{
  "manifest_version": 3,
  "name": "CharityClarity \u2014 Registry Connector",
  "version": "0.5.3",
  "minimum_chrome_version": "132",
  "description": "Connect CharityClarity to public New York, Illinois and Georgia charity records in your browser.",
  "host_permissions": [
    "https://staging.compliance-express.com/*",
    "https://www.compliance-express.com/*",
    "https://compliance-express.com/*",
    "https://charities-search.ag.ny.gov/*",
    "https://charitable.illinoisattorneygeneral.gov/*",
    "https://verify.sos.ga.gov/*"
  ],
  "permissions": [
    "storage",
    "browsingData",
    "cookies"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://verify.sos.ga.gov/verification/SearchResults.aspx*"
      ],
      "js": [
        "registry-ga-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://staging.compliance-express.com/*",
        "https://www.compliance-express.com/*",
        "https://compliance-express.com/*"
      ],
      "js": [
        "protocol.js",
        "staging-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://charities-search.ag.ny.gov/RegistrySearch*"
      ],
      "js": [
        "protocol.js",
        "ny-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://charities-search.ag.ny.gov/RegistrySearch*"
      ],
      "js": [
        "ny-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://charitable.illinoisattorneygeneral.gov/search*",
        "https://verify.sos.ga.gov/verification/*"
      ],
      "js": [
        "registry-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
